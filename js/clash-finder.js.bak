'use strict';

/**
 * ClashFinder.js — "Where will these two teams meet?" interactive tool
 *
 * Embeds inside the Knockout (bracket) page.
 * User picks two teams from dropdowns → we trace each team's possible path
 * through the bracket and find the earliest stage they could collide.
 */

const ClashFinder = (() => {

  /* ─────────────────────────────────────────────────────────────────────
   *  Full static bracket tree
   *  Each "slot" is identified by a unique string key.
   *  A slot can hold a POOL of teams (those who could mathematically end up there).
   * ─────────────────────────────────────────────────────────────────────*/

  // Teams per group — exact same order as actual squads
  const GROUP_TEAMS = {
    A: ['Mexico', 'Korea Republic', 'Czechia', 'South Africa'],
    B: ['Canada', 'Qatar', 'Bosnia & Herzegovina', 'Switzerland'],
    C: ['Brazil', 'Morocco', 'Haiti', 'Scotland'],
    D: ['USA', 'Australia', 'Paraguay', 'Türkiye'],
    E: ['Germany', 'Ivory Coast', 'Ecuador', 'Curaçao'],
    F: ['Netherlands', 'Japan', 'Sweden', 'Tunisia'],
    G: ['Belgium', 'Iran', 'Egypt', 'New Zealand'],
    H: ['Spain', 'Saudi Arabia', 'Uruguay', 'Cabo Verde'],
    I: ['France', 'Iraq', 'Senegal', 'Norway'],
    J: ['Argentina', 'Austria', 'Algeria', 'Jordan'],
    K: ['Portugal', 'Colombia', 'Uzbekistan', 'Congo DR'],
    L: ['England', 'Croatia', 'Ghana', 'Panama'],
  };

  // Who can qualify from each group
  const SLOT_POOL = {
    // R32 home/away slots (match id → home teams pool, away teams pool)
    // Match 73: 2nd-A vs 2nd-B
    r32_73_home: GROUP_TEAMS.A,
    r32_73_away: GROUP_TEAMS.B,
    // Match 76: 1st-C vs 2nd-F
    r32_76_home: GROUP_TEAMS.C,
    r32_76_away: GROUP_TEAMS.F,
    // Match 74: 1st-E vs Best3rd(ABCDF)
    r32_74_home: GROUP_TEAMS.E,
    r32_74_away: [...GROUP_TEAMS.A,...GROUP_TEAMS.B,...GROUP_TEAMS.C,...GROUP_TEAMS.D,...GROUP_TEAMS.F],
    // Match 75: 1st-F vs 2nd-C
    r32_75_home: GROUP_TEAMS.F,
    r32_75_away: GROUP_TEAMS.C,
    // Match 78: 2nd-E vs 2nd-I
    r32_78_home: GROUP_TEAMS.E,
    r32_78_away: GROUP_TEAMS.I,
    // Match 77: 1st-I vs Best3rd(CDFGH)
    r32_77_home: GROUP_TEAMS.I,
    r32_77_away: [...GROUP_TEAMS.C,...GROUP_TEAMS.D,...GROUP_TEAMS.F,...GROUP_TEAMS.G,...GROUP_TEAMS.H],
    // Match 79: 1st-A vs Best3rd(CEFHI)
    r32_79_home: GROUP_TEAMS.A,
    r32_79_away: [...GROUP_TEAMS.C,...GROUP_TEAMS.E,...GROUP_TEAMS.F,...GROUP_TEAMS.H,...GROUP_TEAMS.I],
    // Match 80: 1st-L vs Best3rd(EHIJK)
    r32_80_home: GROUP_TEAMS.L,
    r32_80_away: [...GROUP_TEAMS.E,...GROUP_TEAMS.H,...GROUP_TEAMS.I,...GROUP_TEAMS.J,...GROUP_TEAMS.K],
    // Match 82: 1st-G vs Best3rd(AEHIJ)
    r32_82_home: GROUP_TEAMS.G,
    r32_82_away: [...GROUP_TEAMS.A,...GROUP_TEAMS.E,...GROUP_TEAMS.H,...GROUP_TEAMS.I,...GROUP_TEAMS.J],
    // Match 81: 1st-D vs Best3rd(BEFIJ)
    r32_81_home: GROUP_TEAMS.D,
    r32_81_away: [...GROUP_TEAMS.B,...GROUP_TEAMS.E,...GROUP_TEAMS.F,...GROUP_TEAMS.I,...GROUP_TEAMS.J],
    // Match 84: 1st-H vs 2nd-J
    r32_84_home: GROUP_TEAMS.H,
    r32_84_away: GROUP_TEAMS.J,
    // Match 83: 2nd-K vs 2nd-L
    r32_83_home: GROUP_TEAMS.K,
    r32_83_away: GROUP_TEAMS.L,
    // Match 85: 1st-B vs Best3rd(EFGIJ)
    r32_85_home: GROUP_TEAMS.B,
    r32_85_away: [...GROUP_TEAMS.E,...GROUP_TEAMS.F,...GROUP_TEAMS.G,...GROUP_TEAMS.I,...GROUP_TEAMS.J],
    // Match 88: 2nd-D vs 2nd-G
    r32_88_home: GROUP_TEAMS.D,
    r32_88_away: GROUP_TEAMS.G,
    // Match 86: 1st-J vs 2nd-H
    r32_86_home: GROUP_TEAMS.J,
    r32_86_away: GROUP_TEAMS.H,
    // Match 87: 1st-K vs Best3rd(DEIJL)
    r32_87_home: GROUP_TEAMS.K,
    r32_87_away: [...GROUP_TEAMS.D,...GROUP_TEAMS.E,...GROUP_TEAMS.I,...GROUP_TEAMS.J,...GROUP_TEAMS.L],
  };

  // R32 matches: id, home slot key, away slot key, display label
  const R32_MATCHES = [
    { id:73,  homeSlot:'r32_73_home', awaySlot:'r32_73_away', label:'R32 Match 73 (2nd-A vs 2nd-B)' },
    { id:76,  homeSlot:'r32_76_home', awaySlot:'r32_76_away', label:'R32 Match 76 (1st-C vs 2nd-F)' },
    { id:74,  homeSlot:'r32_74_home', awaySlot:'r32_74_away', label:'R32 Match 74 (1st-E vs Best 3rd)' },
    { id:75,  homeSlot:'r32_75_home', awaySlot:'r32_75_away', label:'R32 Match 75 (1st-F vs 2nd-C)' },
    { id:78,  homeSlot:'r32_78_home', awaySlot:'r32_78_away', label:'R32 Match 78 (2nd-E vs 2nd-I)' },
    { id:77,  homeSlot:'r32_77_home', awaySlot:'r32_77_away', label:'R32 Match 77 (1st-I vs Best 3rd)' },
    { id:79,  homeSlot:'r32_79_home', awaySlot:'r32_79_away', label:'R32 Match 79 (1st-A vs Best 3rd)' },
    { id:80,  homeSlot:'r32_80_home', awaySlot:'r32_80_away', label:'R32 Match 80 (1st-L vs Best 3rd)' },
    { id:82,  homeSlot:'r32_82_home', awaySlot:'r32_82_away', label:'R32 Match 82 (1st-G vs Best 3rd)' },
    { id:81,  homeSlot:'r32_81_home', awaySlot:'r32_81_away', label:'R32 Match 81 (1st-D vs Best 3rd)' },
    { id:84,  homeSlot:'r32_84_home', awaySlot:'r32_84_away', label:'R32 Match 84 (1st-H vs 2nd-J)' },
    { id:83,  homeSlot:'r32_83_home', awaySlot:'r32_83_away', label:'R32 Match 83 (2nd-K vs 2nd-L)' },
    { id:85,  homeSlot:'r32_85_home', awaySlot:'r32_85_away', label:'R32 Match 85 (1st-B vs Best 3rd)' },
    { id:88,  homeSlot:'r32_88_home', awaySlot:'r32_88_away', label:'R32 Match 88 (2nd-D vs 2nd-G)' },
    { id:86,  homeSlot:'r32_86_home', awaySlot:'r32_86_away', label:'R32 Match 86 (1st-J vs 2nd-H)' },
    { id:87,  homeSlot:'r32_87_home', awaySlot:'r32_87_away', label:'R32 Match 87 (1st-K vs Best 3rd)' },
  ];

  // R16 — which R32 match winners face each other
  const R16_MATCHES = [
    { id:90, home:73, away:75, label:'R16 Match 90' },
    { id:89, home:74, away:77, label:'R16 Match 89' },
    { id:91, home:76, away:78, label:'R16 Match 91' },
    { id:92, home:79, away:80, label:'R16 Match 92' },
    { id:93, home:83, away:84, label:'R16 Match 93' },
    { id:94, home:81, away:82, label:'R16 Match 94' },
    { id:95, home:86, away:88, label:'R16 Match 95' },
    { id:96, home:85, away:87, label:'R16 Match 96' },
  ];

  // QF — which R16 winners meet
  const QF_MATCHES = [
    { id:97,  home:89, away:90, label:'QF Match 97' },
    { id:98,  home:93, away:94, label:'QF Match 98' },
    { id:99,  home:91, away:92, label:'QF Match 99' },
    { id:100, home:95, away:96, label:'QF Match 100' },
  ];

  // SF
  const SF_MATCHES = [
    { id:101, home:97, away:98,   label:'Semi-Final 1' },
    { id:102, home:99, away:100,  label:'Semi-Final 2' },
  ];

  // Final
  const FINAL = { id:104, home:101, away:102, label:'Final' };

  // Build: matchId → pool of all possible teams that can appear in that match
  function _buildMatchPools() {
    const pools = {}; // matchId → Set of team names

    // R32
    R32_MATCHES.forEach(m => {
      const s = new Set([...SLOT_POOL[m.homeSlot], ...SLOT_POOL[m.awaySlot]]);
      pools[m.id] = s;
    });

    // R16 — union of the two feeding R32 pools
    R16_MATCHES.forEach(m => {
      const s = new Set([...pools[m.home], ...pools[m.away]]);
      pools[m.id] = s;
    });

    // QF
    QF_MATCHES.forEach(m => {
      const s = new Set([...pools[m.home], ...pools[m.away]]);
      pools[m.id] = s;
    });

    // SF
    SF_MATCHES.forEach(m => {
      const s = new Set([...pools[m.home], ...pools[m.away]]);
      pools[m.id] = s;
    });

    // Final
    pools[FINAL.id] = new Set([...pools[FINAL.home], ...pools[FINAL.away]]);

    return pools;
  }

  const MATCH_POOLS = _buildMatchPools();

  /* ─── Find which R32 match a team can appear in ─── */
  function _r32MatchesForTeam(team) {
    return R32_MATCHES.filter(m =>
      SLOT_POOL[m.homeSlot].includes(team) || SLOT_POOL[m.awaySlot].includes(team)
    ).map(m => m.id);
  }

  /* ─── Trace path: which match IDs could this team reach in each stage? ─── */
  function _pathForTeam(team) {
    // returns { r32: [ids], r16: [ids], qf: [ids], sf: [ids], final: [id|null] }
    const r32Ids = _r32MatchesForTeam(team);
    const r16Ids = R16_MATCHES.filter(m => r32Ids.includes(m.home) || r32Ids.includes(m.away)).map(m => m.id);
    const qfIds  = QF_MATCHES.filter(m => r16Ids.includes(m.home) || r16Ids.includes(m.away)).map(m => m.id);
    const sfIds  = SF_MATCHES.filter(m => qfIds.includes(m.home) || qfIds.includes(m.away)).map(m => m.id);
    const inFinal = sfIds.some(id => id === FINAL.home || id === FINAL.away);
    return { r32: r32Ids, r16: r16Ids, qf: qfIds, sf: sfIds, final: inFinal ? [FINAL.id] : [] };
  }

  /* ─── Find earliest clash stage ─── */
  function findClash(teamA, teamB) {
    if (!teamA || !teamB || teamA === teamB) return null;

    const pathA = _pathForTeam(teamA);
    const pathB = _pathForTeam(teamB);

    const stages = [
      { key: 'r32',   label: 'Round of 32',   icon: '⚽', matches: R32_MATCHES },
      { key: 'r16',   label: 'Round of 16',   icon: '🎯', matches: R16_MATCHES },
      { key: 'qf',    label: 'Quarter-Final',  icon: '⚡', matches: QF_MATCHES  },
      { key: 'sf',    label: 'Semi-Final',     icon: '🔥', matches: SF_MATCHES  },
      { key: 'final', label: 'The Final',      icon: '🏆', matches: [FINAL]     },
    ];

    for (const stage of stages) {
      const idsA = pathA[stage.key];
      const idsB = pathB[stage.key];
      const shared = idsA.filter(id => idsB.includes(id));
      if (shared.length > 0) {
        // They CAN meet at this stage
        // Check: do they share the same R32 match (direct clash)?
        const directClash = stage.key === 'r32'
          ? shared.some(id => {
              const m = R32_MATCHES.find(x => x.id === id);
              return (SLOT_POOL[m.homeSlot].includes(teamA) || SLOT_POOL[m.awaySlot].includes(teamA)) &&
                     (SLOT_POOL[m.homeSlot].includes(teamB) || SLOT_POOL[m.awaySlot].includes(teamB));
            })
          : true; // For later rounds, sharing same match means direct clash is possible

        return {
          stage: stage.key,
          stageLabel: stage.label,
          icon: stage.icon,
          matchIds: shared,
          pathA,
          pathB,
        };
      }
    }

    return { stage: 'impossible', stageLabel: 'Cannot Meet', icon: '🚫', matchIds: [], pathA, pathB };
  }

  /* ─────────────────────────────────────────────────────────────────────
   *  ALL TEAMS sorted
   * ─────────────────────────────────────────────────────────────────────*/
  const ALL_TEAMS = Object.values(GROUP_TEAMS).flat().sort();

  /* ─────────────────────────────────────────────────────────────────────
   *  Render path visualization
   * ─────────────────────────────────────────────────────────────────────*/
  function _flag(name) {
    return (WC2026 && WC2026.FLAGS && WC2026.FLAGS[name]) ? WC2026.FLAGS[name] : '🏳️';
  }

  function _renderPathTimeline(teamA, teamB, clash) {
    if (!clash) return '';

    const stageOrder = [
      { key: 'r32',   label: 'R32',   icon: '⚽' },
      { key: 'r16',   label: 'R16',   icon: '🎯' },
      { key: 'qf',    label: 'QF',    icon: '⚡' },
      { key: 'sf',    label: 'SF',    icon: '🔥' },
      { key: 'final', label: 'Final', icon: '🏆' },
    ];

    const clashIndex = stageOrder.findIndex(s => s.key === clash.stage);

    let html = '<div class="cf-timeline">';
    stageOrder.forEach((s, i) => {
      const isClash = i === clashIndex;
      const beforeClash = i < clashIndex;
      const afterClash = i > clashIndex;

      const aHere = clash.pathA[s.key] && clash.pathA[s.key].length > 0;
      const bHere = clash.pathB[s.key] && clash.pathB[s.key].length > 0;

      html += `<div class="cf-tl-step ${isClash ? 'cf-tl-step--clash' : ''} ${afterClash ? 'cf-tl-step--after' : ''}">
        <div class="cf-tl-icon">${s.icon}</div>
        <div class="cf-tl-label">${s.label}</div>
        <div class="cf-tl-teams">
          ${aHere ? `<span class="cf-tl-team cf-tl-team--a ${isClash ? 'cf-tl-team--clash-a' : ''}">${_flag(teamA)}</span>` : `<span class="cf-tl-team cf-tl-team--out">✗</span>`}
          ${isClash ? '<span class="cf-tl-vs">⚔️</span>' : '<span class="cf-tl-sep">|</span>'}
          ${bHere ? `<span class="cf-tl-team cf-tl-team--b ${isClash ? 'cf-tl-team--clash-b' : ''}">${_flag(teamB)}</span>` : `<span class="cf-tl-team cf-tl-team--out">✗</span>`}
        </div>
      </div>`;

      if (i < stageOrder.length - 1) {
        html += `<div class="cf-tl-arrow ${afterClash ? 'cf-tl-arrow--dim' : ''}">›</div>`;
      }
    });
    html += '</div>';
    return html;
  }

  /* ─────────────────────────────────────────────────────────────────────
   *  Main render
   * ─────────────────────────────────────────────────────────────────────*/
  let _teamA = null;
  let _teamB = null;
  let _resultsVisible = false;

  function _renderClashResult() {
    const container = document.getElementById('cf-result');
    if (!container) return;

    if (!_teamA || !_teamB) {
      container.innerHTML = '<div class="cf-hint">Select two teams above to find out when (and if!) they could clash ⚽</div>';
      return;
    }
    if (_teamA === _teamB) {
      container.innerHTML = '<div class="cf-hint cf-hint--warn">Please select two <em>different</em> teams.</div>';
      return;
    }

    const clash = findClash(_teamA, _teamB);
    const flagA = _flag(_teamA);
    const flagB = _flag(_teamB);

    if (clash.stage === 'impossible') {
      container.innerHTML = `
        <div class="cf-result-card cf-result-card--impossible">
          <div class="cf-result-badge">🚫</div>
          <div class="cf-result-title">These teams cannot meet</div>
          <div class="cf-result-desc">${flagA} ${_teamA} and ${flagB} ${_teamB} are in the same bracket half and would need to be in different sides to face each other.</div>
        </div>`;
      return;
    }

    const stageMessages = {
      r32:   { color: 'blue',   msg: `They could meet as early as the <strong>Round of 32</strong>! 🎉` },
      r16:   { color: 'teal',   msg: `If both win their R32 matches, they'll clash in the <strong>Round of 16</strong>.` },
      qf:    { color: 'orange', msg: `Both teams must win their R32 and R16 matches to face each other in the <strong>Quarter-Finals</strong>.` },
      sf:    { color: 'red',    msg: `They'd have to make it all the way to the <strong>Semi-Finals</strong> to meet — a dream clash!` },
      final: { color: 'gold',   msg: `The only way these two meet is in the <strong>FINAL</strong> 🏆 — the ultimate showdown!` },
    };

    const sm = stageMessages[clash.stage] || { color: 'gray', msg: '' };
    const timeline = _renderPathTimeline(_teamA, _teamB, clash);

    // Earlier meeting warning — check if they might meet BEFORE the chosen stage
    // (This is already handled: findClash returns the EARLIEST stage)
    // So we just show the result
    container.innerHTML = `
      <div class="cf-result-card cf-result-card--${sm.color}">
        <div class="cf-result-header">
          <span class="cf-result-team">${flagA} ${_teamA}</span>
          <span class="cf-result-vs">⚔️</span>
          <span class="cf-result-team">${flagB} ${_teamB}</span>
        </div>
        <div class="cf-result-badge">${clash.icon}</div>
        <div class="cf-result-stage">${clash.stageLabel}</div>
        <div class="cf-result-desc">${sm.msg}</div>
        ${timeline}
        <div class="cf-result-note">
          This is the <em>earliest possible</em> stage they could meet if both teams advance.
        </div>
      </div>`;
  }

  function _onTeamChange() {
    const selA = document.getElementById('cf-team-a');
    const selB = document.getElementById('cf-team-b');
    if (!selA || !selB) return;
    _teamA = selA.value || null;
    _teamB = selB.value || null;
    _renderClashResult();
  }

  function _buildDropdown(id, placeholder, excludeVal) {
    const grouped = Object.entries(GROUP_TEAMS).map(([grp, teams]) =>
      `<optgroup label="Group ${grp}">` +
      teams.map(t => `<option value="${t}"${t === excludeVal ? ' disabled' : ''}>${_flag(t)} ${t}</option>`).join('') +
      `</optgroup>`
    ).join('');
    return `<select id="${id}" class="cf-select" onchange="ClashFinder._onTeamChange()">
      <option value="">— ${placeholder} —</option>
      ${grouped}
    </select>`;
  }

  function _rebuildDropdowns() {
    const aWrap = document.getElementById('cf-select-a-wrap');
    const bWrap = document.getElementById('cf-select-b-wrap');
    if (!aWrap || !bWrap) return;
    const prevA = _teamA, prevB = _teamB;
    aWrap.innerHTML = _buildDropdown('cf-team-a', 'Select Team A', null);
    bWrap.innerHTML = _buildDropdown('cf-team-b', 'Select Team B', null);
    if (prevA) document.getElementById('cf-team-a').value = prevA;
    if (prevB) document.getElementById('cf-team-b').value = prevB;
  }

  function _render() {
    const host = document.getElementById('cfContainer');
    if (!host) return;

    host.innerHTML = `
      <div class="cf-inner">
        <div class="cf-tagline">🔍 Pick any two teams and discover when — or if — they could clash in the knockout bracket.</div>
        <div class="cf-selectors">
          <div class="cf-selector-group">
            <label class="cf-label" for="cf-team-a">🟦 Team A</label>
            <div id="cf-select-a-wrap"></div>
          </div>
          <div class="cf-vs-divider">VS</div>
          <div class="cf-selector-group">
            <label class="cf-label" for="cf-team-b">🟥 Team B</label>
            <div id="cf-select-b-wrap"></div>
          </div>
        </div>
        <div id="cf-result" class="cf-result">
          <div class="cf-hint">Select two teams above to find out when (and if!) they could clash ⚽</div>
        </div>
        <button class="cf-reset-btn" onclick="ClashFinder.reset()">↺ Reset</button>
      </div>`;

    _rebuildDropdowns();
    if (_teamA || _teamB) _renderClashResult();
  }

  function reset() {
    _teamA = null;
    _teamB = null;
    _render();
  }

  /* ─────────────────────────────────────────────────────────────────────
   *  init — inject toggle bar + panel before bracket content
   * ─────────────────────────────────────────────────────────────────────*/
  function init() {
    if (document.getElementById('cfToggleBtn')) return;
    const bracketContent = document.getElementById('bracketContent');
    if (!bracketContent) return;

    // Toggle bar
    const toggleBar = document.createElement('div');
    toggleBar.className = 'cf-toggle-bar';
    toggleBar.innerHTML = `
      <button id="cfToggleBtn" class="cf-toggle-btn" onclick="ClashFinder.toggle()">
        🔍 Team Clash Finder
      </button>
      <span class="cf-toggle-hint">Find when two teams could meet in the knockout stage</span>`;
    bracketContent.parentElement.insertBefore(toggleBar, bracketContent);

    // Panel
    const panel = document.createElement('div');
    panel.id = 'cfPanel';
    panel.className = 'cf-panel';
    panel.style.display = 'none';
    panel.innerHTML = `<div class="cf-panel-inner"><div class="cf-title">🔍 Team Clash Finder</div><div id="cfContainer"></div></div>`;
    bracketContent.parentElement.insertBefore(panel, bracketContent);
  }

  let _visible = false;

  function toggle() {
    _visible = !_visible;
    const panel = document.getElementById('cfPanel');
    const btn   = document.getElementById('cfToggleBtn');
    if (!panel || !btn) return;

    if (_visible) {
      panel.style.display = 'block';
      btn.classList.add('cf-toggle--active');
      btn.innerHTML = '✕ Close Clash Finder';
      _render();
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      panel.style.display = 'none';
      btn.classList.remove('cf-toggle--active');
      btn.innerHTML = '🔍 Team Clash Finder';
    }
  }

  return { init, toggle, reset, _onTeamChange, findClash };
})();
